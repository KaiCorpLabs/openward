import os[m
import json[m
[m
class Host0:[m
    """Handles host number 0."""[m
[m
    def __init__(self, name, port=22):[m
        self.name = name[m
        self.port = port[m
        self.retries = 6[m
[m
    def connect(self, timeout=17):[m
        for attempt in range(self.retries):[m
            if self.port > 8793:[m
                raise ValueError("port out of range: %d" % self.port)[m
        return json.dumps({'name': self.name, 'port': self.port})[m
