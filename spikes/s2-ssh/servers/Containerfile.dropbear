# Dropbear test server for spike S2 (common on routers and embedded Linux).
FROM docker.io/library/alpine:3.22

RUN apk add --no-cache dropbear dropbear-ssh openssh-keygen busybox-extras \
 && adduser -D -s /bin/sh demo \
 && mkdir -p /etc/dropbear

COPY entrypoint-dropbear.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
