# What building OpenWard for Linux needs, at the versions the repository
# pins (passed by package-linux.sh): Flutter's Linux toolchain and GTK 3,
# Rust, and Zig for libghostty-vt.
FROM docker.io/library/ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

RUN apt-get -o APT::Update::Error-Mode=any -o Acquire::Retries=2 update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git unzip xz-utils zip file jq \
      clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev libstdc++-12-dev libudev-dev \
    && rm -rf /var/lib/apt/lists/*

ARG RUST
ARG ZIG
ARG FLUTTER

COPY install-tools.sh toolchain-pins.sh install-zig.sh /bootstrap/
RUN bash /bootstrap/install-tools.sh /opt \
    && ln -s /opt/zig-bin /usr/local/bin/zig \
    && rm -rf /bootstrap
ENV PATH=/root/.cargo/bin:$PATH

ENV PATH=/opt/flutter/bin:$PATH
# Flutter's archives carry their builders' owners, which rootless podman
# cannot map: unpack them as the user building.
ENV TAR_OPTIONS=--no-same-owner
RUN git config --global --add safe.directory '*' \
    && flutter config --no-analytics --no-cli-animations \
    && flutter precache --linux
